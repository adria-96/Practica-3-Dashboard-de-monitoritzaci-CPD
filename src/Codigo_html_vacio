#include <WiFi.h>
#include <WebServer.h>

const char* ssid = "ProjectesSMX";
const char* password = "Hola1234";

WebServer server(80);

// 📄 PÀGINA AMB NOMÉS DISSENY (SENSE DADES REALS)
void enviarPaginaPrincipal() {

  String html = "<html><head>";
  html += "<meta charset='UTF-8'>";

  // 🎨 ESTIL VISUAL
  html += "<style>";
  html += "body{font-family:sans-serif; text-align:center; background:#f4f4f4; margin:0;}";
  html += "h1{color:#333; margin-top:20px;}";
  html += ".container{display:flex; justify-content:center; flex-wrap:wrap; margin-top:30px;}";
  html += ".card{width:180px; padding:20px; margin:10px; border-radius:12px; color:white;}";
  html += ".temp{background:gray;}";
  html += ".llum{background:gray;}";
  html += ".humitat{background:gray;}";
  html += "</style>";

  html += "</head><body>";

  html += "<h1>📊 Monitor CPD</h1>";

  html += "<div class='container'>";

  // 🌡️ TEMPERATURA (sense dades)
  html += "<div class='card temp'>";
  html += "<h3>Temperatura</h3>";
  html += "<p>-- °C</p>";
  html += "</div>";

  // 💡 LLUM (sense dades)
  html += "<div class='card llum'>";
  html += "<h3>Llum</h3>";
  html += "<p>--</p>";
  html += "</div>";

  // 💧 HUMITAT (opcional demo dashboard)
  html += "<div class='card humitat'>";
  html += "<h3>Humitat</h3>";
  html += "<p>-- %</p>";
  html += "</div>";

  html += "</div>";

  html += "</body></html>";

  server.send(200, "text/html", html);
}

void setup() {
  Serial.begin(115200);

  WiFi.begin(ssid, password);

  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
  }

  server.on("/", enviarPaginaPrincipal);
  server.begin();
}

void loop() {
  server.handleClient();
}
